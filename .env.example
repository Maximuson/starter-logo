# Environment variables for Docker Compose.
# Copy to `.env` for local development:
#   cp .env.example .env
#
# Docker Compose reads this file automatically.
# Cursor Cloud Agents also create `.env` from this file on first boot.

# App
APP_PORT=3000
# Helps Next.js detect file changes inside Docker
WATCHPACK_POLLING=true

# Postgres container settings
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432

# App connection string used by Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# `db` is the Docker Compose service name, not `localhost`
DATABASE_URL=postgresql://app:app@db:5432/app

# Vercel production: set DATABASE_URL in Vercel project settings (not in this file).
# Use a hosted Postgres URL with SSL, e.g. Neon or Vercel Postgres.
