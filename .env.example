# Environment variables for Docker Compose.
# Copy to `.env` for local development:
#   cp .env.example .env
#
# Docker Compose reads this file automatically.
# Cursor Cloud Agents also create `.env` from this file on first boot.

# Port exposed on your machine for the Next.js app
APP_PORT=3000

# Helps Next.js detect file changes inside Docker on some systems
WATCHPACK_POLLING=true
